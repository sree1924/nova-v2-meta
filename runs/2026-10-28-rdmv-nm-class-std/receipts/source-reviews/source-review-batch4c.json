          "char_start": 2653,
          "char_end_exclusive": 2745,
          "excerpt": "Do not stop at an accident unless you are involved or if emergency help has not yet arrived.",
          "excerpt_sha256": "c209cc6e0f62a67f92519dc6a45cf766197eced276fcc2e594e904327898744b"
        }
      ],
      "independent_audit": false,
      "current_source_currency_verified": false
    },
    {
      "section": "sec15",
      "part": "C",
      "fact_id": "sec15-F02",
      "statement": "While passing a crash, concentrate on driving and watch for people beside or within the road.",
