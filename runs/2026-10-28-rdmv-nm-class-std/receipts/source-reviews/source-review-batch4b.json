      "section": "sec14",
      "part": "C2",
      "fact_id": "sec14-R16",
      "statement": "Wetness, snow or ice can make an otherwise safe road hazardous; high speed increases skid risk during a sudden turn or stop.",
      "primary_physical_page": 36,
      "supporting_physical_pages": [],
      "verdict": "SOURCE_FIDELITY_CHECKED_BY_AUTHOR",
