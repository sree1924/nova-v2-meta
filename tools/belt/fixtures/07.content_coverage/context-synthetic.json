        "stem": "How far before a turn does the Examplia handbook say to signal?",
        "options": [
          {
            "key": "A",
            "text": "At the turn itself",
            "rationale": "Wrong: signalling at the turn gives no warning."
          },
          {
            "key": "B",
            "text": "After starting the turn",
            "rationale": "Wrong: a signal after starting the turn is too late."
          },
          {
            "key": "C",
            "text": "Only when other cars are present",
            "rationale": "Wrong: the handbook requires signalling every time."
          },
          {
            "key": "D",
            "text": "At least 100 feet before the turn",
            "rationale": "The handbook sets at least 100 feet."
