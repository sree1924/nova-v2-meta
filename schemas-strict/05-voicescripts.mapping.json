    "accepted_inputs.carddeck": "the accepted 04.cards adapter artifact (decks[].cards[], recaps[]) — the only source of equality targets",
    "fact_registry": "{facts:{<fact_id>:{statement, status}}} for teaching.fact_ids resolution",
    "media_disposition": "contracts/media-disposition.json body + hash at loaded_refs/ref_sha256 media_disposition",
    "input_manifest_sha256": "scoped input manifest digest"
  },
  "lints": {
    "stage_directions": "tools/belt/lib/cards-sessions-common.mjs STAGE_DIRECTION_PATTERNS (\"[beat]\"-style brackets, pause word, timed wait/think/pause \"... three seconds\", \"N seconds of silence\", ellipsis timing markers, production cues) + SPEAK_REQUEST_RE (imperative say/speak/read ... out loud). A sourced fact such as \"stay three seconds behind\" is NOT flagged.",
    "practice_only": "PRACTICE_ONLY_PATTERNS: official answer(s), official (test|exam) question(s), actual test/exam, actual question, real (test|exam) question(s), real test/exam",
    "deictic_visual": "DEICTIC_VISUAL_RE: this/that/these/the following/the pictured (road) sign(s)/signal/image/picture/photo/marking/symbol/shape/diagram; \"shown here/above/below\"; \"in the image/picture/photo\"",
    "pronunciation": "spokenTokens(term) == spokenTokens(say) (NFKC lowercase letter/number runs; consecutive single letters collapse: \"U.S.\" == \"U S\"), else proper_noun true AND term is capitalized word(s)"
  },
  "checks": [
    "05.SCHEMA",
    "05.STRING_BOUNDS",
    "05.SCRIPT_IDS",
    "05.NARRATED_FIELDS",
    "05.SCRIPT_SHAPE",
    "05.SEGMENT_ORDER",
    "05.RECALL_PAUSE",
    "05.THINK_REF",
    "05.SELF_EQUALITY",
    "05.CARD_COVERAGE",
    "05.CARD_PARITY",
    "05.RECAP_PARITY",
    "05.TEACHING_FACT_IDS",
    "05.STAGE_DIRECTIONS",
    "05.PRACTICE_ONLY",
    "05.LEARNER_SCAFFOLD",
    "05.DEICTIC_VISUAL",
    "05.PRONUNCIATION",
    "05.AUDIO_RENDER",
    "05.INPUT_BINDING"
  ],
  "deviations": [
    {
      "field": "(every object)",
      "parent_rule": "additionalProperties true",
      "adapter_rule": "additionalProperties false; all keys required, nullable via anyOf",
      "reason": "Meta strict subset",
      "compensating_check": "05.SCHEMA"
    },
    {
      "field": "/schema_version",
      "parent_rule": "const \"1.0.0\"",
      "adapter_rule": "enum [\"1.0.0\"]",
      "reason": "single-value enum is equivalent",
      "compensating_check": "05.SCHEMA"
    },
    {
      "field": "/adapter_version, /input_manifest_sha256, /candidate_lineage_id, /media_disposition_ref, /audio_render, /think_cue",
      "parent_rule": "absent",
      "adapter_rule": "required pilot fields",
      "reason": "hash-boundary correction; pinned media disposition; render non-applicability sentinel; one shared silent-recall cue",
      "compensating_check": "05.STRING_BOUNDS, 05.INPUT_BINDING, 05.AUDIO_RENDER, 05.THINK_REF"
    },
    {
      "field": "/artifact_hash",
      "parent_rule": "optional string",
      "adapter_rule": "omitted",
      "reason": "an artifact cannot carry its own digest",
      "compensating_check": "05.SCHEMA — artifact_hash is not carried; bytes are hashed by the dispatcher (post-validate CLI artifact_sha256); previously: post-validate.mjs CLI artifact_sha256"
    },
    {
      "field": "/audio_scripts/*/narration_text",
      "parent_rule": "required fused string containing the back verbatim",
      "adapter_rule": "replaced by segments{question{lead_in,text}, think_ref, recall_pause_ms, answer{lead_in,text}, teaching{text,fact_ids}} (card) or recap{hooks_spoken, narration_text} (recap)",
      "reason": "overlay role 05 + contract SOP 1 v1.2 SEGMENTED; Order Q §1 recall beat must sit between question and answer",
      "compensating_check": "05.SCRIPT_SHAPE, 05.SEGMENT_ORDER, 05.RECALL_PAUSE, 05.SELF_EQUALITY, 05.CARD_PARITY"
    },
    {
      "field": "/audio_scripts/*/must_match_card_back",
      "parent_rule": "string|boolean (recaps false)",
      "adapter_rule": "string|null (recaps null)",
      "reason": "\"true\" carried no meaning; recaps have no back",
      "compensating_check": "05.SCRIPT_SHAPE"
    },
    {
      "field": "/audio_scripts/*/{must_match_memory_hook, is_recap, script_id, module_id, unit_id, fact_ids, image_asset_id}",
      "parent_rule": "absent",
      "adapter_rule": "required",
      "reason": "prompt 05-card-scripts: hook equality target, preserve card/module/unit/fact ids; deictic visuals need a bound asset id",
      "compensating_check": "05.SELF_EQUALITY, 05.CARD_PARITY, 05.SCRIPT_IDS, 05.DEICTIC_VISUAL"
    },
    {
      "field": "/audio_scripts/*/{tone,pacing,repeat_count,pause_after_ms}",
      "parent_rule": "optional; if voice=narrated then required",
      "adapter_rule": "required nullable",
      "reason": "strict mode forbids if/then",
      "compensating_check": "05.NARRATED_FIELDS"
    },
    {
      "field": "/audio_scripts/*/pronunciation/*",
      "parent_rule": "{term, say} additionalProperties true",
      "adapter_rule": "{term, say, proper_noun}",
      "reason": "prompt: say must normalize to the same tokens unless the term is a flagged proper noun",
      "compensating_check": "05.PRONUNCIATION"
    },
    {
      "field": "/audio_scripts/*/source_ref",
      "parent_rule": "{ref, tier, url?, retrieved_at?}",
      "adapter_rule": "{ref, tier, url|null, pdf_page, printed_page, page_map_id} (same as 04 card source_ref)",
      "reason": "carried through unchanged from the accepted card",
      "compensating_check": "05.CARD_PARITY"
    },
    {
      "field": "/audio_scripts/*/visual_route",
      "parent_rule": "enum [\"tap_ui\", null] (no type)",
      "adapter_rule": "anyOf [{string enum tap_ui}, null]",
      "reason": "strict-mode nullable form; same values",
      "compensating_check": "05.SCHEMA, 05.SCRIPT_SHAPE"
    }
  ],
  "dropped_constraints": [
