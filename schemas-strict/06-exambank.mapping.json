  "dropped_constraints_note": "json_pointer values are prefixed 'parent:' — they address the PARENT schema; the adapter itself uses no soft keyword (strict-lint ok without exemptions).",
  "added_invariants": [
    {
      "rule": "Order Q §4 rule 1 — needs_review zero and no unresolved self-flagged distractor",
      "check": "06.NEEDS_REVIEW_ZERO, 06.SELF_FLAGGED_RESOLVED"
    },
    {
      "rule": "Order Q §4 rule 5 — >20% pairwise form overlap requires a learner-visible note on both forms; note claims machine-asserted",
      "check": "06.FORM_OVERLAP"
    },
    {
      "rule": "Order Q §4 rule 6 — identical correct+distractors+rationale regardless of stem; identical stem+answer duplicates",
      "check": "06.ITEM_CLONE, 06.DUPLICATE_STEM"
    },
    {
      "rule": "Order Q §4 rule 15 — titled counts and declared_count equal served item ids",
      "check": "06.DECLARED_COUNT, 06.TITLED_PROMISE"
    },
    {
      "rule": "source-debt numeral leak — no numeral asserting an unverified official fact in a learner string; item numerals anchored in verified bound facts",
      "check": "06.FORM_NUMERALS, 06.ITEM_NUMERALS"
    },
    {
      "rule": "no actual/real/leaked/official-question claims; practice label mandatory; no prediction; 'full' length only when verified",
      "check": "06.BANNED_CLAIMS, 06.PRACTICE_LABEL"
    }
  ],
  "sentinels": [
    {
      "field": "/practice_forms/*/official_mirror/{n_questions,passing,time}",
      "kind": "official_number_record",
      "shape": "{value:null|number, status:unknown|verified, source_page:null|string}",
      "rule": "status unknown => value null (no numeric hint); verified => value + source_page non-null",
      "compensating_check": "06.OFFICIAL_MIRROR"
    }
  ],
