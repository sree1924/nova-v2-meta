          "char_start": 1313,
          "char_end_exclusive": 1392,
          "excerpt": "Do not stop on the road if at all possible.  Pull off the road in a safe place.",
          "excerpt_sha256": "43b2f694ac17ccef99f686f4923466a416841dc915f93aa3681db6bd1d4dcbdc"
        }
      ],
      "independent_audit": false,
      "current_source_currency_verified": false
    },
    {
      "section": "sec14",
      "part": "C",
      "fact_id": "sec14-F10",
      "statement": "If the engine stops while driving, hold the wheel firmly; the manual warns that steering may become difficult though still possible.",
      "primary_physical_page": 34,
      "supporting_physical_pages": [],
      "verdict": "SOURCE_FIDELITY_CHECKED_BY_AUTHOR",
      "conditions_actors_numbers_reviewed": true,
      "evidence": [
