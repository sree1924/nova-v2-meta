          "char_start": 2746,
          "char_end_exclusive": 2853,
          "excerpt": "Keep your \nattention on your driving and keep moving, watching for people who might be in or near the road.",
          "excerpt_sha256": "781203be3dd35a14bf65e48040d564969c8665039ed9181454d625ca5cd9fcaa"
        }
      ],
      "independent_audit": false,
      "current_source_currency_verified": false
    },
    {
      "section": "sec15",
      "part": "C",
      "fact_id": "sec15-F03",
      "statement": "Do not travel to a crash, fire or disaster merely to watch, because you may obstruct responders and recovery vehicles.",
      "primary_physical_page": 36,
      "supporting_physical_pages": [],
      "verdict": "SOURCE_FIDELITY_CHECKED_BY_AUTHOR",
      "conditions_actors_numbers_reviewed": true,
      "evidence": [
