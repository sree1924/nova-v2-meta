      "evidence": [
        {
          "physical_page": 36,
          "page_text_sha256": "c2ec9c5e435f517184524d185e187c43e228227d8cacf5cf1515bd3cd114bc12",
          "char_start": 31,
          "char_end_exclusive": 248,
          "excerpt": "Any road that is safe under normal conditions can be dangerous when it is wet \nor has snow or ice on it.  High speeds under normal conditions also increase the \npossibility of a skid if you must turn or stop suddenly.",
          "excerpt_sha256": "870bdc287c105d9710f2c082d5e9bb7c267c0b8e7d294bb1c806c0fe0c8f81e0"
