    },
    {
      "json_pointer": "parent:/properties/module_quizzes/items/properties/domain",
      "keyword": "minLength",
      "parent_value": 1,
      "compensating_check": "06.MODULE_QUIZ_COVERAGE"
    },
    {
      "json_pointer": "parent:/properties/self_flagged_distractors/items/properties/item_id",
      "keyword": "minLength",
      "parent_value": 1,
      "compensating_check": "06.ID_INTEGRITY (must resolve)"
    },
    {
      "json_pointer": "parent:/properties/self_flagged_distractors/items/properties/distractor",
      "keyword": "minLength",
      "parent_value": 1,
      "compensating_check": "06.SELF_FLAGGED_RESOLVED (option_key enum; must not target the correct key)"
    },
    {
      "json_pointer": "parent:/properties/self_flagged_distractors/items/properties/why_possibly_correct",
      "keyword": "minLength",
      "parent_value": 1,
      "compensating_check": "06.SELF_FLAGGED_RESOLVED"
    },
    {
      "json_pointer": "parent:/$defs/sourceRef/properties/ref",
      "keyword": "minLength",
      "parent_value": 1,
      "compensating_check": "06.ITEM_BINDING"
    },
    {
      "json_pointer": "parent:/$defs/sourceRef/properties/retrieved_at",
      "keyword": "format",
      "parent_value": "date-time",
      "compensating_check": "field not carried at 06; downstream stage 08: 08.LIVENESS_RECEIPT_SHAPE validates retrieved_at date-time"
    },
    {
      "json_pointer": "parent:/$defs/examItem/properties/id",
      "keyword": "minLength",
      "parent_value": 1,
