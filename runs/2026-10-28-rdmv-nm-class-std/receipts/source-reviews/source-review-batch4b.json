          "char_start": 250,
          "char_end_exclusive": 311,
          "excerpt": "Skids are caused when \nthe tires can no longer grip the road.",
          "excerpt_sha256": "d6e840c59778a8e2529e8b47451d2110b6459525dc3c07ac4b1198675a52b789"
