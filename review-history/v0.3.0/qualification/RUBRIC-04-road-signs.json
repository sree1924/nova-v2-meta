  "blocking_checks": [
    {
      "check_id": "Q04-BOUND-INPUTS",
      "requirement": "State is explicitly locked; selected source document/chapter/page map, accepted KG/Blueprint/sign-list, canonical contract, parent schema, strict projection, run config, prompt and frozen rubric hashes resolve to actual bytes. No unresolved source/projection binding or rights blocker.",
      "evaluator": "controller_and_independent_auditor"
    },
    {
      "check_id": "Q04-SCHEMA",
      "requirement": "Independent strict-projection validation passes; canonical CardDeck compatibility and declared adapter changes are checked. Projection is not authored or weakened after seeing a failure.",
      "evaluator": "independent_validator"
    },
    {
      "check_id": "Q04-COUNT-COVERAGE",
      "requirement": "At least25 genuine sourced cards; target25, no duplicate padding. Accepted nodes covered or justified merged; genuine component atomics allowed; module/unit IDs, source refs, dynamic flags, review tiers and recaps satisfy04.",
      "evaluator": "independent_validator_and_07"
    },
    {
      "check_id": "Q04-FACTS-HELDOUT",
      "requirement": "All15 presealed auditor-authored held-out source checks are executed. facts_contradicting_source=0; no unsupported/incorrect additional card claim is accepted. Generator-written facts/checklists are never the independent oracle.",
      "evaluator": "independent_08"
    },
    {
      "check_id": "Q04-PAGE-CITATIONS",
      "requirement": "Every card has a valid registered selected-handbook page citation tracing its fact. For selected Texas this must be the bound DL-7 page map. cards_missing_page_citation=0; titles/URLs alone are insufficient.",
      "evaluator": "independent_08"
    },
    {
      "check_id": "Q04-ORIGINALITY",
      "requirement": "Original learner prose throughout cards/hooks/recaps. max_contiguous_source_word_overlap<=12 against the registered full handbook. A13-word normalized contiguous match in any learner-facing field fails; citation/source-ref metadata is excluded from this text scan.",
      "evaluator": "independent_overlap_checker"
    },
    {
      "check_id": "Q04-TEACHING-MEMORY",
      "requirement": "Every card has a meaningful source-true ear-friendly hook. The unit contains why/how, a worked/contextual example, a misconception correction, memory support and an aligned assessment rationale using the declared teaching projection/refs. Sol plan preserves ask/silent recall/narrator answer/hook; no compulsory learner speech or false rendered-audio claim.",
      "evaluator": "independent_07_and_08"
    },
    {
      "check_id": "Q04-INDEPENDENCE",
      "requirement": "Held-out author and result auditor are independent of Meta generator; qualified reviewer identities/model receipts exist. Held-out15 questions/expected answers and item IDs were not supplied in any generator prompt or retry feedback. Authorship/receipt claims are evidenced.",
      "evaluator": "controller_and_independent_auditor"
    },
    {
      "check_id": "Q04-PROVENANCE",
      "requirement": "Actual standard Meta request/returned model, raw request/response, output hash, whole prompt-file hash, template-body hash and provider request identity or honest unavailability reason are recorded. A code-assistant session is not the measured Meta call.",
      "evaluator": "controller"
    },
    {
      "check_id": "Q04-USAGE-COST-LATENCY",
      "requirement": "All physical attempt receipts, usage totals, estimated/reported numeric USD with pricing provenance and elapsed milliseconds are recorded. Unknown usage/cost stays null and cannot satisfy this qualification gate. Cached/other token subtotals are not double-counted.",
      "evaluator": "controller"
    },
    {
      "check_id": "Q04-ATTEMPT-CHRONOLOGY",
      "requirement": "1<=attempt_count<=2 including SDK/transport retries that dispatched model requests; no silent attempt reset or model escalation. heldout.sealed_at<=generation_started_at<=completed_at. Report latency/cost/usage cover all attempts, including failures.",
      "evaluator": "controller"
    },
    {
      "check_id": "Q04-CANDIDATE-BINDING",
      "requirement": "All check evidence and reviewer reports bind to the exact output.candidate_hash and frozen input hashes; every blocking check is actually executed and PASS. Repaired bytes need fresh independent retest; stale acceptance cannot be relabelled.",
      "evaluator": "controller_and_independent_auditor"
    }
  ],
