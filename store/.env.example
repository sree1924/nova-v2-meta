# PassLearnersPermit store — every variable the app reads.
# Copy to .env.local for local work (never commit .env.local). On Vercel set them per environment.

# --- Clerk (dev instance locally; PRODUCTION instance on passlearnerspermit.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx            # prod: pk_live_xxx
CLERK_SECRET_KEY=sk_test_xxx                             # prod: sk_live_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Never let @clerk/nextjs create a "keyless" dev instance on its own.
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=1

# --- Stripe (test mode locally; live on prod) ---
STRIPE_SECRET_KEY=sk_test_xxx                            # prod: sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx                          # from the endpoint .../api/stripe/webhook
# Price of the Stripe product "Driver's permit prep: one state, one year" — one-time, USD 9.99.
# Optional: when empty, checkout sends an inline $9.99 price_data line item instead.
# Fulfillment refuses any session whose amount_total is not 999 USD cents either way.
STRIPE_PRICE_ID=price_xxx

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://passlearnerspermit.com     # local: http://localhost:4320

# --- Entitlement cookie (optional) ---
# HMAC key for the signed plp_ent cookie that unlocks paid /app/** files.
# Defaults to a key derived from CLERK_SECRET_KEY. Set a long random value to rotate it independently.
ENTITLEMENT_COOKIE_SECRET=
