          "char_start": 942,
          "char_end_exclusive": 1061,
          "excerpt": "Continue to correct your steering, left and right, until the \nvehicle is again moving down the road under your control.",
          "excerpt_sha256": "c73cc348928c2b975d9a3d0c97ec48782f87d7a029a27a12a460781ecb824ac9"
        }
      ],
      "independent_audit": false,
      "current_source_currency_verified": false
    },
