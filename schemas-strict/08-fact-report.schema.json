{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nova-local:strict-adapter:08-fact-report.v0.4.0",
  "title": "FactReport strict adapter (post-seal, candidate-bound, tier-first, liveness-receipted)",
  "description": "Provider-facing strict-subset adapter for stage 08.content_facts. Echoes the sealed candidate_sha256 and fixed-key input hashes; tier resolution precedes judgement; every cited source carries a dated liveness receipt in contracts/source-liveness-receipt.schema.json shape; flagged findings carry evidence/severity/owner/route; auditor identity is checked against intervention lineage; a source-supported blocking finding cannot be outvoted. Parent allOf (PASS => no visual/grouped-unit claim issues) and all bounds are restored in tools/belt/checks/08-content-facts.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "adapter_version", "probe", "minted_by", "candidate_sha256", "input_hashes", "source_refs", "assigned_scope", "auditor", "verdict", "tier_resolution_first", "claim_tiers", "source_liveness", "flagged", "source_supported_blocking_findings", "unsourced", "visual_claim_issues", "grouped_unit_claim_issues", "verification_debt", "external_review_requests", "publish_blocked", "checks_run", "required_checks_not_run"],
  "properties": {
    "artifact_type": { "type": "string", "enum": ["FactReport"] },
    "adapter_version": { "type": "string", "enum": ["0.4.0"] },
    "probe": { "type": "string" },
    "minted_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "lane", "pass"],
      "properties": {
        "model": { "type": "string" },
        "lane": { "type": "string" },
        "pass": { "type": "string" }
      }
    },
    "candidate_sha256": { "type": "string" },
    "input_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprint", "carddeck", "voice_scripts", "session_scripts", "exambank", "source_registry", "curriculum_unit_map", "source_liveness"],
      "properties": {
        "blueprint": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "carddeck": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "voice_scripts": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "session_scripts": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "exambank": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "source_registry": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "curriculum_unit_map": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "source_liveness": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprint", "carddeck", "voice_scripts", "session_scripts", "exambank", "source_registry", "image_scout_plan", "curriculum_unit_map"],
      "properties": {
        "blueprint": { "type": "string" },
        "carddeck": { "type": "string" },
        "voice_scripts": { "type": "string" },
        "session_scripts": { "type": "string" },
        "exambank": { "type": "string" },
        "source_registry": { "type": "string" },
        "image_scout_plan": { "type": "string" },
        "curriculum_unit_map": { "type": "string" }
      }
    },
    "assigned_scope": { "type": "string" },
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_family", "actor_id", "session_id", "model"],
      "properties": {
        "provider_family": { "type": "string" },
        "actor_id": { "type": "string" },
        "session_id": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "verdict": { "type": "string", "enum": ["PASS", "FAIL", "HOLD"] },
    "tier_resolution_first": { "type": "boolean", "enum": [true] },
    "claim_tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "item_ref", "source_ref", "tier", "fact_ids"],
        "properties": {
          "claim_id": { "type": "string" },
          "item_ref": { "type": "string" },
          "source_ref": { "type": "string" },
          "tier": { "type": "string", "enum": ["official", "regulator", "exam_owner", "standards_body", "reputable", "unverified"] },
          "fact_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "source_liveness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref", "snapshot_sha256", "official_url", "source_tier", "retrieved_at", "edition", "effective_date", "issuer_current_edition_ref", "issuer_current_edition_sha256", "verified_by", "status"],
        "properties": {
          "source_ref": { "type": "string" },
          "snapshot_sha256": { "type": "string" },
          "official_url": { "type": "string" },
          "source_tier": { "type": "string", "enum": ["issuer", "official_regulator", "official_standard"] },
          "retrieved_at": { "type": "string" },
          "edition": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "effective_date": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "issuer_current_edition_ref": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "issuer_current_edition_sha256": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "verified_by": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor_id", "provider_family"],
            "properties": {
              "actor_id": { "type": "string" },
              "provider_family": { "type": "string" }
            }
          },
          "status": { "type": "string", "enum": ["PASS", "VERIFICATION_DEBT"] }
        }
      }
    },
    "flagged": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "item_id", "artifact_hash", "source_page", "issue", "evidence", "severity", "owner_worker", "repair_route"],
        "properties": {
          "check_id": { "type": "string" },
          "item_id": { "type": "string" },
          "artifact_hash": { "type": "string" },
          "source_page": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "issue": { "type": "string" },
          "evidence": { "type": "string" },
          "severity": { "type": "string", "enum": ["blocking", "major", "minor"] },
          "owner_worker": { "type": "string", "enum": ["01b", "02", "03", "04", "05", "06", "13", "15", "19A", "20A", "09", "00"] },
          "repair_route": { "type": "string", "enum": ["route_to_producer", "route_to_evidence_librarian", "verification_debt", "publish_blocked", "external_review_required"] }
        }
      }
    },
    "source_supported_blocking_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "flagged_item_id", "source_ref", "source_page", "evidence"],
        "properties": {
          "finding_id": { "type": "string" },
          "flagged_item_id": { "type": "string" },
          "source_ref": { "type": "string" },
          "source_page": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "unsourced": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "item_ref", "text"],
        "properties": {
          "claim_id": { "type": "string" },
          "item_ref": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "visual_claim_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["media_slot_id", "issue", "claim", "severity"],
        "properties": {
          "media_slot_id": { "type": "string" },
          "issue": { "type": "string", "enum": ["unsupported_alt_claim", "unsupported_caption_claim", "image_used_as_evidence", "decorative_media_claims_fact"] },
          "claim": { "type": "string" },
          "severity": { "type": "string", "enum": ["major", "minor"] }
        }
      }
    },
    "grouped_unit_claim_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit_id", "issue", "claim", "severity"],
        "properties": {
          "unit_id": { "type": "string" },
          "issue": { "type": "string", "enum": ["unsupported_unit_summary", "contradicts_source", "unanchored_number_date_name", "claim_ref_missing"] },
          "claim": { "type": "string" },
          "severity": { "type": "string", "enum": ["major", "minor"] }
        }
      }
    },
    "verification_debt": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "blocker_kind", "detail", "source_tier_required", "owner_worker", "ship_blocking"],
        "properties": {
          "claim_id": { "type": "string" },
          "blocker_kind": { "type": "string" },
          "detail": { "type": "string" },
          "source_tier_required": { "type": "string", "enum": ["official", "regulator", "exam_owner", "standards_body", "reputable", "unverified"] },
          "owner_worker": { "type": "string", "enum": ["01b", "02", "03", "04", "05", "06", "13", "15", "19A", "20A", "09", "00"] },
          "ship_blocking": { "type": "boolean" }
        }
      }
    },
    "external_review_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "claim_ids", "review_kind", "source_tier_checked", "why_human_required", "legal_requirement_ref", "blocking"],
        "properties": {
          "request_id": { "type": "string" },
          "claim_ids": { "type": "array", "items": { "type": "string" } },
          "review_kind": { "type": "string", "enum": ["clinical", "legal", "safety"] },
          "source_tier_checked": { "type": "string", "enum": ["official", "regulator", "exam_owner", "standards_body", "reputable", "unverified"] },
          "why_human_required": { "type": "string" },
          "legal_requirement_ref": { "type": "string" },
          "blocking": { "type": "boolean", "enum": [true] }
        }
      }
    },
    "publish_blocked": { "type": "boolean" },
    "checks_run": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "scope", "evidence"],
        "properties": {
          "check_id": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "HOLD"] },
          "scope": { "type": "string", "enum": ["full", "sampled"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "required_checks_not_run": { "type": "array", "items": { "type": "string" } }
  }
}
