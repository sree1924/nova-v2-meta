{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nova-local:source-liveness-receipt.v0.4.0",
  "title": "Dated official-source liveness evidence",
  "type": "object",
  "required": ["source_ref", "snapshot_sha256", "official_url", "source_tier", "retrieved_at", "edition", "effective_date", "issuer_current_edition_ref", "issuer_current_edition_sha256", "verified_by", "status"],
  "properties": {
    "source_ref": {"type": "string", "minLength": 1},
    "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "official_url": {"type": "string", "minLength": 1},
    "source_tier": {"enum": ["issuer", "official_regulator", "official_standard"]},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "edition": {"type": ["string", "null"]},
    "effective_date": {"type": ["string", "null"]},
    "issuer_current_edition_ref": {"type": ["string", "null"]},
    "issuer_current_edition_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "effective_date_disposition_ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
      "additionalProperties": false
    },
    "verified_by": {"type": "object", "required": ["actor_id", "provider_family"], "properties": {"actor_id": {"type": "string"}, "provider_family": {"type": "string"}}, "additionalProperties": false},
    "status": {"enum": ["PASS", "VERIFICATION_DEBT", "CONFIRMED_EDITION_EFFECTIVE_DATE_DEBT"]}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "PASS"}}}, "then": {"properties": {
    "edition": {"type": "string", "minLength": 1, "not": {"enum": ["unknown", "UNKNOWN", "pending", "PENDING", "(verify)"]}}, "effective_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "issuer_current_edition_ref": {"type": "string", "minLength": 1}, "issuer_current_edition_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }}}, {"if": {"properties": {"status": {"const": "CONFIRMED_EDITION_EFFECTIVE_DATE_DEBT"}}}, "then": {
    "required": ["effective_date_disposition_ref"],
    "properties": {
      "edition": {"type": "string", "minLength": 1, "not": {"enum": ["unknown", "UNKNOWN", "pending", "PENDING", "(verify)"]}},
      "effective_date": {"type": "null"},
      "issuer_current_edition_ref": {"type": "string", "minLength": 1},
      "issuer_current_edition_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }
  }}],
  "additionalProperties": false
}
