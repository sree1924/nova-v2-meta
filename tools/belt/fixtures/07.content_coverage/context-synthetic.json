        "stem": "In Examplia, how many supervised driving hours must a learner permit holder log?",
        "options": [
          {
            "key": "A",
            "text": "20 hours",
            "rationale": "Wrong: 20 hours is half of the handbook figure."
          },
          {
            "key": "B",
            "text": "40 hours",
            "rationale": "The handbook sets 40 supervised hours."
          },
          {
            "key": "C",
            "text": "30 hours",
            "rationale": "Wrong: 30 hours falls short of the handbook figure."
          },
          {
            "key": "D",
            "text": "50 hours",
            "rationale": "Wrong: 50 hours exceeds what the handbook requires."
          }
        ],
        "correct_key": "B",
        "correct_rationale": "40 hours is right: the handbook sets 40 supervised hours.",
        "distractor_source": [
          "kg.confusable:n.permit.hours~half-figure",
