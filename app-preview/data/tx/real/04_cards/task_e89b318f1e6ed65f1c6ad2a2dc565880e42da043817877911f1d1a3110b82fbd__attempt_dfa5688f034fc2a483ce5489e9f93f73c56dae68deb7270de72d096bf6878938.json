  "recaps": [
    {
      "module": "Where you may not park, stop or stand",
      "module_id": "sec07-m01",
      "recap_hooks": [
        {
          "text": "Turn off the motor, set the brake, take the key, and check behind before opening the door.",
          "fact_ids": [
            "sec07-F01"
          ]
        },
        {
          "text": "Never park, stop, or stand in crosswalks, intersections, or on bridges or tracks.",
          "fact_ids": [
            "sec07-F02",
            "sec07-R01"
          ]
        },
        {
          "text": "Keep fifteen feet from hydrants and twenty feet from crosswalks.",
          "fact_ids": [
            "sec07-F03",
            "sec07-R02"
          ]
        },
        {
          "text": "On rural highways, park off the road or leave passing room with clear sight both ways.",
          "fact_ids": [
            "sec07-F04",
            "sec07-R03"
          ]
        }
      ]
    },
    {
      "module": "Disabled parking",
      "module_id": "sec07-m02",
      "recap_hooks": [
        {
          "text": "Abusing a disabled space brings fines that climb with each offense.",
          "fact_ids": [
            "sec07-F05",
            "sec07-R04"
          ]
        },
        {
          "text": "A disabled card is used only while carrying its holder and is never lent.",
          "fact_ids": [
            "sec07-F06",
            "sec07-R05"
          ]
        }
      ]
    },
    {
      "module": "Unattended cars and parking moves",
      "module_id": "sec07-m03",
      "recap_hooks": [
        {
          "text": "Before leaving a car unattended, turn off the engine, lock the ignition, take the key, set the brake, and curb the wheels on a grade.",
          "fact_ids": [
            "sec07-F07",
            "sec07-R06"
          ]
        },
        {
          "text": "Start a parallel park two feet out beside the lead car.",
          "fact_ids": [
            "sec07-F08",
            "sec07-R07"
          ]
        },
        {
          "text": "Finish six inches from the curb and never more than eighteen inches away.",
          "fact_ids": [
            "sec07-F09",
            "sec07-R08"
          ]
        },
        {
          "text": "On hills, angle the wheels to the curb as the handbook shows, and never coast downhill in neutral.",
          "fact_ids": [
            "sec07-F10",
            "sec07-R08"
          ]
        }
      ]
    }
