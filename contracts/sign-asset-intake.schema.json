{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nova-local:sign-asset-intake.v0.4.0",
  "title": "Selected-state sign intake; an unbound template is never a production sign list",
  "type": "object",
  "required": ["artifact_type", "version", "status", "producer_role", "selected_jurisdiction", "source_registry_sha256", "mutcd_edition", "state_supplement_disposition", "rights_statement_receipt", "signs"],
  "properties": {
    "artifact_type": {"const": "SelectedStateSignIntake"},
    "version": {"const": "0.4.0"},
    "status": {"enum": ["UNBOUND_TEMPLATE", "BOUND"]},
    "producer_role": {"const": "15"},
    "selected_jurisdiction": {"type": ["string", "null"]},
    "source_registry_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "mutcd_edition": {"type": ["string", "null"]},
    "state_supplement_disposition": {"type": ["object", "null"], "properties": {"status": {"enum": ["applicable", "not_applicable_with_evidence"]}, "evidence_ref": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "required": ["status", "evidence_ref", "sha256"]},
    "rights_statement_receipt": {"type": ["object", "null"], "properties": {"official_url": {"type": "string"}, "retrieved_at": {"type": "string", "format": "date-time"}, "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "statement_locator": {"type": "string"}}, "required": ["official_url", "retrieved_at", "snapshot_sha256", "statement_locator"]},
    "signs": {"type": "array", "items": {"type": "object", "required": ["sign_id", "edition", "asset_url", "local_asset_ref", "sha256", "rights_ref", "rights_sha256", "fact_ids", "source_pages", "selected_state_applicability_ref"], "properties": {
      "sign_id": {"type": "string", "minLength": 1}, "edition": {"type": "string", "minLength": 1},
      "asset_url": {"type": "string", "minLength": 1}, "local_asset_ref": {"type": "string", "minLength": 1},
      "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "rights_ref": {"type": "string", "minLength": 1},
      "rights_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "fact_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "source_pages": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "selected_state_applicability_ref": {"type": "string", "minLength": 1}
    }, "additionalProperties": false}},
    "execution_enabled": {"const": false},
    "template_is_not_a_bound_sign_list": {"type": "boolean"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "BOUND"}}}, "then": {"properties": {
    "selected_jurisdiction": {"type": "string", "minLength": 1}, "source_registry_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mutcd_edition": {"type": "string", "minLength": 1}, "state_supplement_disposition": {"type": "object"},
    "rights_statement_receipt": {"type": "object"}, "signs": {"minItems": 1}
  }}}],
  "additionalProperties": false
}
