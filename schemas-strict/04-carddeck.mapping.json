  "deviations": [
    {
      "field": "(every object)",
      "parent_rule": "additionalProperties true",
      "adapter_rule": "additionalProperties false; every property required (nullable via anyOf)",
      "reason": "Meta strict subset",
      "compensating_check": "04.SCHEMA"
    },
    {
      "field": "/schema_version",
      "parent_rule": "const \"1.0.0\"",
      "adapter_rule": "enum [\"1.0.0\"]",
      "reason": "const not relied on in strict mode; single-value enum is equivalent",
      "compensating_check": "04.SCHEMA"
    },
    {
      "field": "/adapter_version, /input_manifest_sha256, /candidate_lineage_id, /media_disposition_ref, /back_format, /srs_policy, /merges, /verification_debt",
      "parent_rule": "absent",
      "adapter_rule": "required pilot fields",
      "reason": "hash-boundary correction (input manifest + lineage, never final candidate digest); pinned media disposition; spoken_text back format; deterministic SRS policy; recorded merges and typed debt",
      "compensating_check": "04.STRING_BOUNDS, 04.INPUT_BINDING, 04.MEDIA_DISPOSITION, 04.BACK_SPOKEN_FORM, 04.SRS_POLICY, 04.MERGES, 04.VERIFICATION_DEBT"
    },
    {
      "field": "/artifact_hash",
      "parent_rule": "optional string (SHA-256 over canonical body)",
      "adapter_rule": "omitted",
      "reason": "an artifact cannot carry its own digest; bytes are hashed by the dispatcher/manifest — the collector verifies the artifact hash unconditionally (COLLECTOR.ARTIFACT_HASH); no in-artifact digest",
      "compensating_check": "post-validate.mjs CLI artifact_sha256"
    },
    {
      "field": "/source_refs/image_scout_post_kg",
      "parent_rule": "required string (post-KG ImageScoutPlan ref)",
      "adapter_rule": "enum [\"deferred:not_applicable_pilot\"]",
      "reason": "role 20A inactive; no scout plan exists — sentinel instead of an invented plan",
      "compensating_check": "04.MEDIA_DISPOSITION"
    },
    {
      "field": "/source_refs/curriculum_unit_hints",
      "parent_rule": "optional string",
      "adapter_rule": "required string|null",
      "reason": "strict mode requires every key",
      "compensating_check": "04.SCHEMA"
    },
    {
      "field": "/decks/*/exam_weight",
      "parent_rule": "number, minimum 0",
      "adapter_rule": "OFFICIAL only: {value:number|null, status:unknown|verified, source_page:string|null}; unknown => value null; verified => value>=0 + source_page",
      "reason": "source-fact-policy official_fact_shape; handoff integration note 6: an authored status must never promote an official weight",
      "compensating_check": "04.EXAM_WEIGHT_STATUS, 04.STRING_BOUNDS"
    },
    {
      "field": "/decks/*/pedagogic_emphasis",
      "parent_rule": "absent (parent exam_weight conflated official and computed weight)",
      "adapter_rule": "{value:number|null, kind:\"authored_product_policy\"}",
      "reason": "source-fact-policy numerical_weights.pedagogic_emphasis = labelled authored product policy",
      "compensating_check": "04.EXAM_WEIGHT_STATUS"
    },
    {
      "field": "/decks/*/cards/*/id",
      "parent_rule": "id (minLength 1)",
      "adapter_rule": "card_id",
      "reason": "pilot field name per design (stable card id)",
      "compensating_check": "04.CARD_IDS, 04.STRING_BOUNDS"
    },
    {
      "field": "/decks/*/cards/*/module_id",
      "parent_rule": "absent on card (deck-level)",
      "adapter_rule": "required, must equal deck module_id",
      "reason": "Amendment 2026-06-14: flashcards carry module_id",
      "compensating_check": "04.STRING_BOUNDS"
    },
    {
      "field": "/decks/*/cards/*/unit_id",
      "parent_rule": "optional string",
      "adapter_rule": "required string|null",
      "reason": "strict mode",
      "compensating_check": "04.SCHEMA"
    },
    {
      "field": "/decks/*/cards/*/media_slot_id",
      "parent_rule": "optional string (scout slot)",
      "adapter_rule": "not carried",
      "reason": "image cards disabled in the text-first pilot; no scout slots exist",
      "compensating_check": "04.MEDIA_DISPOSITION"
    },
    {
      "field": "/decks/*/cards/*/{hook_origin,cluster_id,cluster_role,claims_fact_ids}",
      "parent_rule": "absent (contract SOP 1/3 only)",
      "adapter_rule": "required; hook_origin enum sme-carried|sme-adapted|minted; cluster_role umbrella|atomic|null; claims_fact_ids[]",
      "reason": "contract SOP 1 (atomize + cluster_id), SOP 3 (hook_origin), prompt 04 (fact_ids resolve to accepted facts)",
      "compensating_check": "04.HOOK_ORIGIN, 04.ATOMIC_CLUSTER, 04.FACT_IDS, 04.BACK_FIDELITY"
    },
    {
      "field": "/decks/*/cards/* (decompression)",
      "parent_rule": "additionalProperties true would admit why_how/example/misconception text",
      "adapter_rule": "no why_how/example/misconception/recall-pause field exists; additionalProperties false rejects them",
      "reason": "overlay role 04 adaptations: decompression belongs to 05.sessions, recall pause to 05.card_scripts",
      "compensating_check": "04.SCHEMA"
    },
    {
      "field": "/decks/*/cards/*/source_ref",
      "parent_rule": "{ref, tier, url?, retrieved_at? (date-time)}, additionalProperties true",
      "adapter_rule": "{ref, tier, url|null, pdf_page:int|null, printed_page:string|null, page_map_id:string|null}",
      "reason": "page-bound citation for Q04-PAGE-CITATIONS; retrieval/liveness evidence lives in the source registry + liveness receipt, not the card",
      "compensating_check": "04.PAGE_CITATIONS, 04.PAGE_RESOLUTION, 04.STRING_BOUNDS"
    },
    {
      "field": "/recaps/*",
      "parent_rule": "{module, recap_hooks: string[] minItems 1}",
      "adapter_rule": "{module, module_id, recap_hooks: [{text, fact_ids[]}]}",
      "reason": "prompt 04: every fact-bearing recap has fact_ids",
      "compensating_check": "04.RECAP_PER_DECK, 04.FACT_IDS, 04.STRING_BOUNDS, 04.BACK_SPOKEN_FORM"
    },
    {
      "field": "/srs_policy",
      "parent_rule": "absent (contract SOP 5 prose)",
      "adapter_rule": "enum-bound {easy:relaxed, medium:standard, hard:tight} + tighten_one_step, policy_kind product_policy, learning_loop_ref",
      "reason": "deterministic policy bound from V1 (srs_policy_binding); never invented interval values",
      "compensating_check": "04.SRS_POLICY"
    }
  ],
