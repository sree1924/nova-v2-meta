      "compensating_check": "05.FACT_RESOLUTION, 05.UNIQUE_ITEMS"
    },
    {
      "field": "/units/*/slides",
      "parent_rule": "minItems 3, maxItems 9, contains self_check",
      "adapter_rule": "6..8 (restored), >=1 self_check + >=1 trap/bridge (restored)",
      "reason": "Order Q §4 rule 7 six-slide floor supersedes parent minimum",
      "compensating_check": "05.SLIDE_COUNT, 05.SLIDE_ARC"
    },
    {
      "field": "/units/*/slides/*/kind",
