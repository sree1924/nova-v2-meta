      "reason": "owned schema minimum/maximum",
      "compensating_check": "05.NARRATION_SECONDS"
    },
    {
      "field": "/units/* decompression fields",
      "parent_rule": "absent",
      "adapter_rule": "why_how[], worked_example, misconception, memory_support, self_check required",
      "reason": "owned schema; overlay role 04/05: decompression owned by 05.sessions",
      "compensating_check": "05.DECOMPRESSION_FIELDS, 05.MISCONCEPTION_LABELLED, 05.SELF_CHECK_ALIGNED"
