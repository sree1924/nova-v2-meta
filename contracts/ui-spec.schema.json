{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nova-hackathon://ui-spec/0.4.0",
  "title": "Project-local pilot UiSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_scope",
    "status",
    "input_refs",
    "theme",
    "audience",
    "hero_mode",
    "interaction_model",
    "screens",
    "flows",
    "visual_system",
    "information_density",
    "exam_sim_design",
    "accessibility",
    "gamification",
    "domain_affordances",
    "onboarding",
    "monetization_surfaces",
    "media_intent",
    "mobile_bundle",
    "reviewer_trace",
    "validation_plan"
  ],
  "properties": {
    "schema_version": {
      "const": "rdmv.ui-spec.0.4.0"
    },
    "product_scope": {
      "const": "regular_passenger_car_written_test_prep"
    },
    "status": {
      "enum": [
        "draft",
        "improved"
      ]
    },
    "input_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "domain_rationale"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domain_rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "selection_status",
        "language",
        "study_context"
      ],
      "properties": {
        "jurisdiction": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_status": {
          "enum": [
            "pending",
            "locked"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "study_context": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hero_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "route_id",
        "media_disposition_ref",
        "verbal_fallback_label",
        "unverified_visuals_block"
      ],
      "properties": {
        "id": {
          "const": "sign_recognition_drill"
        },
        "route_id": {
          "const": "cards"
        },
        "media_disposition_ref": {
          "$ref": "#/$defs/ref"
        },
        "verbal_fallback_label": {
          "type": "string",
          "minLength": 1
        },
        "unverified_visuals_block": {
          "const": true
        }
      }
    },
    "interaction_model": {
      "type": "string",
      "minLength": 1
    },
    "screens": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "audience",
          "learner_navigation",
          "purpose",
          "artifact_bindings"
        ],
        "properties": {
          "id": {
            "enum": [
              "home",
              "chapter_hub",
              "lesson",
              "cards",
              "quiz",
              "practice",
              "results",
              "trace"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "enum": [
              "learner",
              "reviewer"
            ]
          },
          "learner_navigation": {
            "type": "boolean"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "artifact_bindings": {
            "type": "array",
            "minItems": 0,
            "items": {
              "$ref": "#/$defs/ref"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "id": {
                  "const": "trace"
                }
              },
              "required": [
                "id"
              ]
            },
            "then": {
              "properties": {
                "audience": {
                  "const": "reviewer"
                },
                "learner_navigation": {
                  "const": false
                }
              }
            },
            "else": {
              "properties": {
                "audience": {
                  "const": "learner"
                },
                "learner_navigation": {
                  "const": true
                }
              }
            }
          }
        ]
      },
      "maxItems": 8
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "audience"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "enum": [
              "learner",
              "reviewer"
            ]
          }
        }
      }
    },
    "visual_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette",
        "typography",
        "imagery",
        "motion",
        "copy_voice",
        "mood"
      ],
      "properties": {
        "palette": {
          "type": "string",
          "minLength": 1
        },
        "typography": {
          "type": "string",
          "minLength": 1
        },
        "imagery": {
          "type": "string",
          "minLength": 1
        },
        "motion": {
          "type": "string",
          "minLength": 1
        },
        "copy_voice": {
          "type": "string",
          "minLength": 1
        },
        "mood": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "information_density": {
      "type": "string",
      "minLength": 1
    },
    "exam_sim_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "practice_only",
        "learning_loop_ref",
        "verified_exam_facts_ref"
      ],
      "properties": {
        "practice_only": {
          "const": true
        },
        "learning_loop_ref": {
          "$ref": "#/$defs/ref"
        },
        "verified_exam_facts_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "accessibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gamification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_progress_only",
        "no_pass_prediction"
      ],
      "properties": {
        "observed_progress_only": {
          "const": true
        },
        "no_pass_prediction": {
          "const": true
        }
      }
    },
    "domain_affordances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "onboarding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_taps_to_first_card",
        "pending_scope_blocks",
        "trace_link_present"
      ],
      "properties": {
        "max_taps_to_first_card": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "pending_scope_blocks": {
          "const": true
        },
        "trace_link_present": {
          "const": false
        }
      }
    },
    "monetization_surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "auth",
        "payments",
        "lead_capture"
      ],
      "properties": {
        "mode": {
          "const": "free_only_preview"
        },
        "auth": {
          "const": false
        },
        "payments": {
          "const": false
        },
        "lead_capture": {
          "const": false
        }
      }
    },
    "media_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_density",
        "domain_media_style",
        "allowed_media_roles",
        "avoid",
        "module_intents",
        "narration_status"
      ],
      "properties": {
        "media_density": {
          "enum": [
            "text_first",
            "sparse",
            "moderate",
            "rich"
          ]
        },
        "domain_media_style": {
          "type": "string",
          "minLength": 1
        },
        "allowed_media_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "anchor",
              "portrait",
              "map",
              "diagram",
              "symbol",
              "none"
            ]
          }
        },
        "avoid": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "module_intents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module_id",
              "media_required",
              "preferred_treatment",
              "reason"
            ],
            "properties": {
              "module_id": {
                "type": "string",
                "minLength": 1
              },
              "media_required": {
                "type": "boolean"
              },
              "preferred_treatment": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "narration_status": {
          "const": "deferred_not_available_pilot"
        }
      }
    },
    "mobile_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework",
        "shared_with_web",
        "targets",
        "native_affordances",
        "store_listing",
        "pilot_disposition"
      ],
      "properties": {
        "framework": {
          "const": "expo/react-native"
        },
        "shared_with_web": {
          "const": true
        },
        "targets": {
          "type": "array",
          "minItems": 2,
          "items": {
            "enum": [
              "ios",
              "android"
            ]
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "native_affordances": {
          "type": "array",
          "minItems": 5,
          "items": {
            "enum": [
              "offline_cache",
              "background_audio",
              "push",
              "deep_link",
              "install"
            ]
          },
          "uniqueItems": true
        },
        "store_listing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "icon",
            "screenshots",
            "category",
            "status"
          ],
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "icon": {
              "type": [
                "string",
                "null"
              ]
            },
            "screenshots": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "category": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "const": "deferred_not_implemented"
            }
          }
        },
        "pilot_disposition": {
          "const": "specified_native_delivery_deferred"
        }
      }
    },
    "reviewer_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "learner_nav_link",
        "committed_ledger_only",
        "redaction_policy_ref"
      ],
      "properties": {
        "route_id": {
          "const": "trace"
        },
        "learner_nav_link": {
          "const": false
        },
        "committed_ledger_only": {
          "const": true
        },
        "redaction_policy_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "schema_validator_role",
        "independent_semantic_review",
        "phases",
        "receipt_storage"
      ],
      "properties": {
        "schema_ref": {
          "const": "contracts/ui-spec.schema.json"
        },
        "schema_validator_role": {
          "const": "14"
        },
        "independent_semantic_review": {
          "const": true
        },
        "phases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "enum": [
              "validate_1",
              "validate_2"
            ]
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "receipt_storage": {
          "const": "separate_hash_bound_UIAcceptanceBundle"
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "uiValidationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "phase",
        "kind",
        "status",
        "spec_sha256",
        "schema_sha256",
        "content_candidate_sha256",
        "actor_id",
        "provider_family",
        "session_id",
        "evidence_refs"
      ],
      "properties": {
        "schema_version": {
          "const": "rdmv.ui-validation-receipt.0.4.0"
        },
        "phase": {
          "enum": [
            "validate_1",
            "validate_2"
          ]
        },
        "kind": {
          "enum": [
            "role14_schema",
            "independent_semantic"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_EXECUTED"
          ]
        },
        "spec_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_candidate_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_family": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    },
    "uiAcceptanceBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "content_candidate_sha256",
        "draft_spec_ref",
        "improved_spec_ref",
        "validate_1",
        "validate_2",
        "audit_independence_ref"
      ],
      "properties": {
        "schema_version": {
          "const": "rdmv.ui-acceptance-bundle.0.4.0"
        },
        "content_candidate_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "draft_spec_ref": {
          "$ref": "#/$defs/ref"
        },
        "improved_spec_ref": {
          "$ref": "#/$defs/ref"
        },
        "validate_1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_receipt_ref",
            "independent_receipt_ref"
          ],
          "properties": {
            "schema_receipt_ref": {
              "$ref": "#/$defs/ref"
            },
            "independent_receipt_ref": {
              "$ref": "#/$defs/ref"
            }
          }
        },
        "validate_2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_receipt_ref",
            "independent_receipt_ref"
          ],
          "properties": {
            "schema_receipt_ref": {
              "$ref": "#/$defs/ref"
            },
            "independent_receipt_ref": {
              "$ref": "#/$defs/ref"
            }
          }
        },
        "audit_independence_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    }
  }
}
