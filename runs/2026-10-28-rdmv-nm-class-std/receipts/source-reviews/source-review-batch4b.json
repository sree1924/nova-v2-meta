      "supporting_physical_pages": [],
      "verdict": "SOURCE_FIDELITY_CHECKED_BY_AUTHOR",
      "conditions_actors_numbers_reviewed": true,
      "evidence": [
        {
          "physical_page": 36,
          "page_text_sha256": "c2ec9c5e435f517184524d185e187c43e228227d8cacf5cf1515bd3cd114bc12",
          "char_start": 1196,
          "char_end_exclusive": 1352,
          "excerpt": "If \nnothing works, try to lessen any injuries that could result from the crash.  The most important thing you \ncan do is to use your lap and shoulder belts.",
          "excerpt_sha256": "8edae6c6b9916fb739650be9689d7fbef2ff41824697ff4de6e0423c659700dc"
        }
      ],
      "independent_audit": false,
      "current_source_currency_verified": false
    },
    {
      "section": "sec14",
      "part": "C2",
      "fact_id": "sec14-R22",
      "statement": "For a rear impact, the handbook directs bracing against the seat back with the head against its restraint.",
      "primary_physical_page": 36,
      "supporting_physical_pages": [],
      "verdict": "SOURCE_FIDELITY_CHECKED_BY_AUTHOR",
      "conditions_actors_numbers_reviewed": true,
      "evidence": [
        {
          "physical_page": 36,
          "page_text_sha256": "c2ec9c5e435f517184524d185e187c43e228227d8cacf5cf1515bd3cd114bc12",
          "char_start": 1484,
          "char_end_exclusive": 1650,
          "excerpt": "If your vehicle is hit from the rear, your body will be thrown backwards.  Press yourself against the back \nof your seat and put your head against the head restraint.",
          "excerpt_sha256": "2b6ce23f9fb9a961cc8e99e4d86e65f8c93b0a748b5f3ada30efd98ab7b24338"
        }
      ],
      "independent_audit": false,
      "current_source_currency_verified": false
    },
